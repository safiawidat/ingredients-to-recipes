DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Explicit local/development opt-in; normal db:seed stays blocked in production.
ALLOW_DATABASE_SEED=false
# One-time CLI deployment initialization only; do not keep enabled at runtime.
ALLOW_PRODUCTION_DATABASE_INITIALIZATION=false
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=development-only-replace-with-a-secure-random-secret
JWT_EXPIRES_IN=15m
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
